<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes

    # 1. Block access to hidden files and directories (.env, .git, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # 2. Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,NC]

    # 3. Block access to sensitive root files
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js) - [F,NC]

    # 4. Strip /public/ from URL if accessed directly (canonical URL)
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # 5. Pass Authorization headers (needed for Sanctum / API tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 6. Send all remaining traffic to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>